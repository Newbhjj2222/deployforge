# ───────────────────────── DeployForge configuration ─────────────────────────
# Copy to .env. NEVER commit .env. Generate secrets with:  openssl rand -base64 32

# Branding / addressing -------------------------------------------------------
PLATFORM_NAME=DeployForge
ROOT_DOMAIN=localhost            # deployments live at <slug>.<ROOT_DOMAIN>
APP_HOST=app.localhost           # the dashboard host
PUBLIC_SCHEME=http               # https in production
PUBLIC_PORT_SUFFIX=:8080         # empty in production (default ports)
TRUST_PROXY=true                 # behind Caddy: trust X-Forwarded-For for rate limiting

# Database / queue ------------------------------------------------------------
POSTGRES_USER=deployforge
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=deployforge
DATABASE_URL=postgresql://deployforge:change-me-dev-only@postgres:5432/deployforge?schema=public
REDIS_URL=redis://redis:6379

# Secrets (REQUIRED) ----------------------------------------------------------
# ENCRYPTION_KEYS: comma list of "<id>:<base64 32 bytes>". Rotate by adding a new id and setting ENCRYPTION_KEY_ACTIVE.
# Keep these outside the database; use a secret manager in production.
ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
ENCRYPTION_KEY_ACTIVE=1
AUTH_SECRET=REPLACE_WITH_RANDOM_32_BYTES_BASE64
AUTH_TRUST_HOST=true
INTERNAL_TOKEN=REPLACE_WITH_RANDOM_TOKEN_16_PLUS_CHARS
SANDBOX_AGENT_TOKEN=REPLACE_WITH_RANDOM_TOKEN_16_PLUS_CHARS
SANDBOX_AGENT_URL=http://sandbox-agent:8700

# Storage ---------------------------------------------------------------------
STORAGE_DRIVER=local             # local = DEVELOPMENT ONLY. Use s3 in production.
STORAGE_LOCAL_DIR=/data/artifacts
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=                     # e.g. https://<account>.r2.cloudflarestorage.com or http://minio:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# GitHub App (see docs/github-app.md) -------------------------------------------
GITHUB_API_URL=https://api.github.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=          # PEM (use \n for newlines) or base64 of the PEM
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Optional "Sign in with GitHub" (can reuse the App's OAuth credentials)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Development-only: deploy from a local folder of git repositories (rejected when NODE_ENV=production)
DEV_LOCAL_GIT_ROOT=/dev-repos

# Resource limits ---------------------------------------------------------------
LIMIT_PROJECTS_PER_ORG=10
LIMIT_DEPLOYMENTS_PER_PROJECT_PER_DAY=50
LIMIT_ENV_VARS_PER_PROJECT=100
LIMIT_DOMAINS_PER_PROJECT=10
BUILD_TIMEOUT_SECONDS=900
INSTALL_TIMEOUT_SECONDS=900
CLONE_TIMEOUT_SECONDS=180
BUILD_MEMORY_MB=2048
BUILD_CPUS=2
BUILD_PIDS_LIMIT=512
RUNTIME_MEMORY_MB=512
RUNTIME_CPUS=0.5
MAX_ARTIFACT_FILES=10000
MAX_ARTIFACT_BYTES=524288000
MAX_ARTIFACT_FILE_BYTES=52428800
MAX_LOG_LINES_PER_DEPLOYMENT=20000
MAX_LOG_BYTES_PER_DEPLOYMENT=5242880
LOG_RETENTION_DAYS=30
WORKER_CONCURRENCY=2

# Custom domains / TLS (production) ---------------------------------------------
CNAME_TARGET=                    # defaults to edge.<ROOT_DOMAIN>
EDGE_IPV4=                       # shown for apex-domain A records
EDGE_IPV6=
EDGE_TLS_PROBE_ADDR=             # host:443 of the public TLS listener, enables certificate status checks
DNS_RESOLVERS=1.1.1.1,8.8.8.8    # resolvers used for TXT ownership checks
ACME_EMAIL=

# --- production only (docker-compose.prod.yml) ---
# Redis requires a password in prod; REDIS_URL must then be redis://:<REDIS_PASSWORD>@redis:6379
REDIS_PASSWORD=
# Absolute host path of the data directory (sibling containers are started through the host Docker daemon)
HOST_DATA_DIR=/var/lib/deployforge
