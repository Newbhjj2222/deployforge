{
  "name": "@deployforge/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f test/constraints.sql && vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@deployforge/core": "*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.35.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
